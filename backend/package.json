{
  "name": "@bluelight-hub/backend",
  "version": "1.0.0-alpha.9",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:windows": "nexe dist/main.js --build -t windows --dest-cpu=x64 --verbose",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "package": "esbuild src/main.ts --bundle --platform=node --outfile=dist/bundle.js --external:class-validator --external:@nestjs/microservices --external:@nestjs/platform-socket.io",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@bluelight-hub/shared": "link:../shared",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/platform-express": "^11.0.6",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.4.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@pdfme/common": "^5.3.2",
    "@pdfme/generator": "^5.3.2",
    "@pdfme/schemas": "5.3.2",
    "ajv": "^8.17.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "joi": "^17.13.3",
    "mongoose": "^8.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "taktische-zeichen-core": "^0.9.0"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@nestjs/cli": "11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "22.12.0",
    "@types/papaparse": "^5.3.15",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "8.22.0",
    "esbuild": "^0.24.2",
    "eslint": "9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nexe": "4.0.0-rc.6",
    "pkg": "^5.8.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      ",/node_modules/",
      "\\.module\\.ts$"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@10.0.0"
}
