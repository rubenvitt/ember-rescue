generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bearbeiter {
  id                       String                   @id() @default(cuid())
  name                     String                   @unique
  active                   Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  fahrzeug_status_historie FahrzeugStatusHistorie[]
  einsatz                  Einsatz[]
  einsatztagebuch_eintrag  EinsatztagebuchEintrag[]
  Notizen                  Notiz[]
  Reminder                 Reminder[]

  @@map("bearbeiter")
}

model Fahrzeug {
  id                       String                   @id @default(cuid())
  label                    String?                  @unique
  optaOrtId                Int?
  optaFunktionId           Int?
  optaOrdnung              Int?
  funkrufname              String                   @default(dbgenerated())
  kapazitaet               Int
  aktuellerStatusId        String?
  status                   Status?                  @relation(fields: [aktuellerStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fahrzeug_status_historie FahrzeugStatusHistorie[]
  einsatz_fahrzeug         FahrzeugOnEinsatz[]
  Einsatz                  Einsatz[]
  organisation             String?
  fachaufgabe              String?
  verwaltungsstufe         String?
  istTemporaer             Boolean
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  optaOrt      OptaOrt?      @relation(fields: [optaOrtId], references: [optaCode], onUpdate: Cascade, onDelete: Cascade)
  optaFunktion OptaFunktion? @relation(fields: [optaFunktionId], references: [optaCode], onUpdate: Cascade, onDelete: Cascade)

  @@unique([optaOrtId, optaFunktionId, optaOrdnung])
  @@map("fahrzeuge")
}

model OptaFunktion {
  id               String            @id @default(cuid())
  label            String
  optaCode         Int               @unique
  categoryId       String
  einheit          Einheit?
  funktion         Funktion?
  organisation     Organisation?
  verwaltungsstufe Verwaltungsstufe?
  grundzeichen     Grundzeichen?
  fachaufgabe      Fachaufgabe?
  symbol           Symbol?

  category OptaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  fahrzeuge Fahrzeug[]

  @@index([id, label, optaCode, categoryId])
  @@map("optaFunktion")
}

