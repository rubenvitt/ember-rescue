{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "../shared/dist",
        "rootDir": "../shared",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "../shared/**/*"
    ]
}